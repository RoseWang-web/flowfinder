{
  "name": "flowfinder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:ext": "tsc -p extension/tsconfig.json && vite build -c extension/vite.config.ts && vite build -c extension/vite.content.config.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "webgazer": "^3.5.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^31.0.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^5.1.0"
  }
}
